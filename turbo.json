{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "*.config.*", "tsconfig.json", "package.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "*.config.*", ".eslintrc*", "eslint.config.*"]
    },
    "test": {
      "inputs": ["src/**", "*.config.*"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "inputs": ["src/**", "e2e/**", "playwright.config.*"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
