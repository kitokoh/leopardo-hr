# ============================================================
# Leopardo Edge API — Production Docker Image
# Published to: leopardo/edge-api:VERSION
#
# STATUS: this is the ACTIVE Dockerfile used by edge/publish.sh to build
# and push the public leopardo/edge-api image to Docker Hub. See
# Dockerfile.edge for the local/dev image built by edge/docker-compose.yml,
# and Dockerfile (no suffix) for a standalone FrankenPHP reference image
# that is not currently wired into any build script.
#
# Build: docker build -f Dockerfile.publish -t leopardo/edge-api:1.0.0 .
# Push:  docker push leopardo/edge-api:1.0.0
# ============================================================
FROM php:8.4-fpm-alpine AS base

LABEL maintainer="Leopardo RH <dev@leopardo.app>"
LABEL version="1.0.0"
LABEL description="Leopardo Edge API — Local offline-first HR server"

WORKDIR /var/www/html

# ── System Dependencies ────────────────────────────────────
RUN apk add --no-cache \
    nginx \
    sqlite \
    sqlite-dev \
    curl \
    zip \
    unzip \
    git \
    supervisor \
    openssl \
    ca-certificates

# ── PHP Extensions ─────────────────────────────────────────
RUN docker-php-ext-install \
    pdo \
    pdo_sqlite \
    opcache \
    pcntl \
    bcmath

# ── PHP Configuration ──────────────────────────────────────
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "memory_limit=256M" >> /usr/local/etc/php/conf.d/memory.ini \
 && echo "upload_max_filesize=20M" >> /usr/local/etc/php/conf.d/upload.ini \
 && echo "post_max_size=20M" >> /usr/local/etc/php/conf.d/upload.ini

# ── Composer ───────────────────────────────────────────────
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# ── Application ────────────────────────────────────────────
COPY api/ .

# Install PHP dependencies (production only)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-progress \
    --prefer-dist

# Set permissions
RUN chown -R www-data:www-data storage bootstrap/cache \
 && chmod -R 775 storage bootstrap/cache

# ── Edge Data Directory ────────────────────────────────────
# #7966 — chown www-data : l'image tourne désormais entièrement en non-root
# (migrations SQLite dans l'entrypoint + php-fpm/nginx via supervisord, tous
# en www-data) — le volume /var/leopardo doit être inscriptible par cet
# utilisateur (propriété initialisée à la 1re création du volume nommé).
RUN mkdir -p /var/leopardo && chmod 755 /var/leopardo \
 && chown www-data:www-data /var/leopardo

# ── Exécution non-root (#7966) ─────────────────────────────
# Répertoires inscriptibles par www-data : logfile/pidfile supervisord et
# logs des programmes (/var/log/supervisor), temp/lock nginx tels que
# compilés par le paquet Alpine (client_body/fastcgi temp sous
# /var/lib/nginx/tmp, lock sous /run/nginx) — le master nginx n'est plus
# root (port :8080, cf. nginx.edge.conf).
RUN mkdir -p /var/log/supervisor /run/nginx \
 && chown www-data:www-data /var/log/supervisor \
 && chown -R www-data:www-data /var/lib/nginx /var/log/nginx /run/nginx

# ── Config Files ───────────────────────────────────────────
COPY edge/nginx.edge.conf /etc/nginx/nginx.conf
COPY edge/supervisord.edge.conf /etc/supervisor/conf.d/leopardo.conf
COPY edge/docker-entrypoint.publish.sh /usr/local/bin/docker-entrypoint.publish.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.publish.sh

# ── Edge-specific .env ─────────────────────────────────────
ENV APP_ENV=edge \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/var/leopardo/edge.sqlite \
    LOG_CHANNEL=stderr \
    QUEUE_CONNECTION=sync

# #7966 — port non privilégié (nginx écoute en :8080, cf. nginx.edge.conf).
EXPOSE 8080

VOLUME ["/var/leopardo"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/edge/readiness || exit 1

# #4411 : migrations SQLite AVANT supervisord (schéma edge jamais provisionné).
# #7966 — image 100% non-root : USER www-data (PID 1 entrypoint + supervisord
# + nginx master + php-fpm, aucun process root). `-u www-data` est un filet
# de sécurité si le conteneur était relancé avec `--user root` : supervisord
# lit sa config puis retombe en www-data AVANT d'ouvrir logs/pidfile et de
# spawner les programmes (no-op quand l'uid courant est déjà www-data).
USER www-data
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.publish.sh"]
CMD ["/usr/bin/supervisord", "-n", "-u", "www-data", "-c", "/etc/supervisor/conf.d/leopardo.conf"]
