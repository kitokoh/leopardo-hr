# ============================================================
# Leopardo Edge API — Lightweight Laravel for Edge deployment
#
# STATUS: ACTIVE Dockerfile for local/dev usage — built by
# edge/docker-compose.yml for the edge-api and edge-sync services
# (via `docker compose up --build` from edge/). The edge-ui service
# builds from front/web-offline/Dockerfile (Next.js static export).
# See Dockerfile.publish for the production release image built by
# edge/publish.sh, and Dockerfile (no suffix) for a standalone
# FrankenPHP reference image not wired into any build script.
# ============================================================
FROM php:8.4-fpm-alpine

WORKDIR /var/www/html

# Install system deps (runtime uniquement — #7847 : git/nodejs/npm retirés,
# ils ne servaient qu'au build ; ni l'entrypoint ni supervisord ne les
# utilisent — aucun `npm install` dans cette image, composer installe depuis
# les archives dist)
RUN apk add --no-cache \
    nginx \
    sqlite \
    sqlite-dev \
    curl \
    zip \
    unzip \
    supervisor

# Install PHP extensions
RUN docker-php-ext-install pdo pdo_sqlite opcache pcntl

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy source
COPY api/ .

# Install PHP dependencies (no dev) — #7847 : git n'est nécessaire qu'à
# composer (dépôts vcs / repli source) et est purgé dans la même couche,
# il n'existe pas dans l'image finale.
RUN apk add --no-cache --virtual .composer-build-deps git \
    && composer install --no-dev --optimize-autoloader --no-interaction \
    && apk del .composer-build-deps

# #7847 / #7966 — exécution non-root : les programmes applicatifs (php-fpm,
# migration) tournent en `www-data` (voir supervisord.edge.conf) ; depuis
# #7966 l'image ENTIÈRE (supervisord + nginx master inclus) tourne en
# www-data — voir USER plus bas.
# Prépare les répertoires accessibles en écriture pour cet utilisateur :
#   - /var/log/supervisor : logfile + pidfile supervisord et logs programmes
#   - /var/lib/nginx, /var/log/nginx, /run/nginx : temp/lock/pid nginx tels
#     que compilés par le paquet Alpine (client_body/fastcgi temp sous
#     /var/lib/nginx/tmp, lock sous /run/nginx) — requis car le master nginx
#     n'est plus root (port :8080, cf. nginx.edge.conf).
# NB : /var/leopardo est monté en volume nommé (edge_data) — le chown au
# build initialise la propriété du volume à sa première création.
RUN mkdir -p /var/leopardo /var/log/supervisor /run/nginx \
    && chown www-data:www-data /var/leopardo \
    && chmod 755 /var/leopardo \
    && chown www-data:www-data /var/log/supervisor \
    && chown -R www-data:www-data /var/lib/nginx /var/log/nginx /run/nginx \
    && chown -R www-data:www-data storage bootstrap/cache

# SQLite DB will be at /var/leopardo/edge.sqlite (volume mounted)

# Nginx config
COPY edge/nginx.edge.conf /etc/nginx/nginx.conf

# Supervisor for nginx + php-fpm
COPY edge/supervisord.edge.conf /etc/supervisor/conf.d/leopardo.conf

# #7966 — port non privilégié (nginx écoute en :8080, cf. nginx.edge.conf).
EXPOSE 8080

# #7966 — image 100% non-root : tout (PID 1 supervisord, master nginx,
# php-fpm, migration) tourne en www-data. Remplace le modèle #7847 où
# supervisord restait root pour binder :80 et gérer les process.
# `-u www-data` est un filet de sécurité : si le conteneur était relancé
# avec `--user root`, supervisord lit sa config puis retombe en www-data
# AVANT d'ouvrir logs/pidfile et de spawner les programmes (no-op quand
# l'uid courant est déjà www-data).
USER www-data
CMD ["/usr/bin/supervisord", "-n", "-u", "www-data", "-c", "/etc/supervisor/conf.d/leopardo.conf"]
