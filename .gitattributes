# Git Attributes — Leopardo RH
# Définit les stratégies de merge par type de fichier

# CHANGELOG : stratégie union = accepte les deux ajouts sans conflit
CHANGELOG.md merge=union
# Fichiers texte : normalisation des fins de ligne
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.php   text eol=lf
*.dart  text eol=lf
*.sh    text eol=lf
*.neon  text eol=lf
# Fichiers binaires — trackés en Git LFS (issue #1727)
# Les fichiers LFS sont stockés hors-git (GitHub LFS) ; le checkout CI doit
# utiliser actions/checkout avec lfs: true (fait sur tous les workflows).
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.apk   filter=lfs diff=lfs merge=lfs -text
*.aab   filter=lfs diff=lfs merge=lfs -text
# Autres binaires (hors LFS pour l'instant)
*.ico   binary
*.pdf   binary
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text

# QA #2829 : médias vitrine hors Git LFS — le build Vercel ne résout pas LFS
# (pointeurs servis en prod → images/vidéo cassées). Binaires réels commités.
front/web/public/screenshots/*.png -filter -diff -merge
front/web/public/videos/* -filter -diff -merge

# Fix CI LFS : ces PNG (générés par #2889 depuis les SVG) ont été commités en
# contenu réel, pas en pointeurs LFS — git-lfs en CI les réécrivait → la garde
# i18n « Check generated files are committed » échouait sur main. Les exclure
# du filtre LFS (petits fichiers, aucun besoin de stockage externe).
front/web/public/apple-touch-icon.png !filter !diff !merge -text
front/web/public/icon-192.png !filter !diff !merge -text
front/web/public/icon-512.png !filter !diff !merge -text
front/web/public/logo.png !filter !diff !merge -text
front/web/public/og/default.png !filter !diff !merge -text
