# Audit #1701 : variables requises par l'admin-dashboard.
# Copier vers .env.local et adapter.
#
# #8707 — DEUX voies, dans cet ordre de priorité :
#
#   1. VITE_API_PROXY_BASE_URL (RECOMMANDÉ, y compris en production)
#      URL du proxy STABLE du front web. La cible d'API est choisie par ce
#      proxy au RUNTIME (API_PROXY_TARGET > BACKEND_API_URL > NEXT_PUBLIC_API_URL),
#      donc une bascule de stack ne demande plus AUCUN rebuild de ce dashboard.
#      Exemple déployé : https://gestionemployer-backend.vercel.app/api/v1
#
#   2. VITE_API_URL (appel direct à un fournisseur — déconseillé)
#      Refusé dans un build de production par assertProductionInvariant(),
#      sauf VITE_ALLOW_DIRECT_API_IN_PROD=true. À réserver au dev local.
#
# QA 2026-08-15 (#2659) : ne mettre une URL en localhost QUE pour le dev local.
VITE_API_PROXY_BASE_URL=
VITE_API_URL=http://localhost:8000/api/v1
# Serveur push Socket.IO (optionnel). Absent → le client dérive wss://<hôte API> (#3392).
VITE_WEBSOCKET_URL=ws://localhost:6001
