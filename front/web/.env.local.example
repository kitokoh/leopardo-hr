# Leopardo RH — Vitrine (front/web, Next.js)
# Copier en `.env.local` (jamais commite) et renseigner les valeurs reelles.
# Voir AUDIT.md pour le contexte complet.

# --- API backend ---
# URL publique de l'API consommee cote navigateur (SDK, formulaires, checkout).
NEXT_PUBLIC_API_URL=https://gestionemployerbackend.onrender.com/api/v1
# Cible du proxy interne `/api/v1/[...path]` et `/api/billing/checkout` (server-side uniquement).
LEOPARDO_API_URL=https://gestionemployerbackend.onrender.com
BACKEND_API_URL=https://gestionemployerbackend.onrender.com/api/v1
API_PROXY_TARGET=
# Token interne optionnel transmis en Authorization par le proxy serveur -> API.
LEOPARDO_INTERNAL_TOKEN=
# Bascule directe vers l'API sans passer par le proxy Next (debug/local uniquement).
NEXT_PUBLIC_API_DIRECT=false

# --- Stripe (checkout self-service) ---
STRIPE_SECRET_KEY=sk_live_or_test_...

# --- Site / branding ---
# `leopardo-hr.vercel.app` renvoie 404 (verifie) ; l'URL reellement en ligne
# aujourd'hui est `gestionemployer-backend.vercel.app` (voir
# docs/GUIDES/GUIDE_LIENS_PLATEFORME_ET_COMMUNICATION.md pour la liste a jour).
NEXT_PUBLIC_SITE_URL=https://gestionemployer-backend.vercel.app
NEXT_PUBLIC_SITE_NAME=Leopardo RH
NEXT_PUBLIC_ADMIN_URL=https://admin.leopardo-rh.com
NEXT_PUBLIC_ENVIRONMENT=production

# --- Feature flags vitrine ---
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_FORMS=true
NEXT_PUBLIC_ENABLE_BLOG=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false

# --- Analytics / tracking ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Formulaires marketing (leads / trial / demo) ---
NEXT_PUBLIC_FORM_ENDPOINT=/api/forms
SENDGRID_API_KEY=
MARKETING_CRM_WEBHOOK_URL=
MARKETING_EMAIL_WEBHOOK_URL=
MARKETING_LEAD_WEBHOOK_TOKEN=
MARKETING_LEAD_FORWARD_TIMEOUT_MS=5000

# --- Liens telechargement apps mobiles (page download) ---
NEXT_PUBLIC_LEOPARDO_EMPLOYEE_ANDROID_URL=
NEXT_PUBLIC_LEOPARDO_EMPLOYEE_IOS_URL=
NEXT_PUBLIC_LEOPARDO_MANAGER_ANDROID_URL=
NEXT_PUBLIC_LEOPARDO_MANAGER_IOS_URL=
NEXT_PUBLIC_LEOPARDO_PLATFORM_ADMIN_ANDROID_URL=
NEXT_PUBLIC_LEOPARDO_PLATFORM_ADMIN_IOS_URL=
