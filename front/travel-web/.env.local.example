# Leopardo Travel — site public de réservation (front/travel-web, Next.js)
# Copier en `.env.local` (jamais commité) et renseigner les valeurs réelles.
# AUCUN secret requis : ce site ne consomme que les endpoints PUBLICS
# /api/v1/public/travel/marketplace/* (issue #7737).

# --- API backend ---
# Cible du proxy interne same-origin `/api/v1/[...path]` (server-side).
# Priorité : API_PROXY_TARGET > BACKEND_API_URL > NEXT_PUBLIC_API_URL
# (même chaîne de résolution que front/web, audit #1701).
# #7963 : plus AUCUN défaut distant en dur — en local, pointer le backend
# Laravel du poste (`php artisan serve`, port 8000) ; en déploiement, poser
# l'URL réelle de l'API (le build Next échoue sans elle).
API_PROXY_TARGET=
BACKEND_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=

# --- Site / SEO ---
# URL canonique du site (metadata OpenGraph, sitemap). Projets Vercel :
# leopardo-travel (dev) / leopardo-travel-prod (prod) — épic #7736.
NEXT_PUBLIC_SITE_URL=https://leopardo-travel.vercel.app
NEXT_PUBLIC_SITE_NAME=Leopardo Travel
