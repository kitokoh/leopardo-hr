<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Issue #2762 — build DEBUG uniquement : autorise l'URL de dev
         documentée http://10.0.2.2:8000 (Android 9+ bloque le clair par
         défaut). Jamais en release. -->
    <application android:usesCleartextTraffic="true" tools:ignore="MissingApplicationIcon"
        xmlns:tools="http://schemas.android.com/tools"/>
</manifest>
