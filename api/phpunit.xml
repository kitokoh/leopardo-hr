    <!-- Groupe `audit` : constats de l'audit Identity & Access Control.
         Ce sont des PREUVES, pas des garde-fous : un test qui asserte
         « aucun endpoint de contexte n'existe » DOIT échouer quand le lot L2
         est livré. La CI les exclut (option exclude-group) pour ne pas
         bloquer la PR qui livre le correctif.
         Le groupe est déclaré par l'attribut #[Group('audit')] sur les classes
         de tests/Feature/Audit/IdentityAccessControl*Test.php — PHPUnit 11
         n'accepte plus d'élément <groups> dans ce fichier.
         Exécution manuelle : vendor/bin/phpunit avec l'option group=audit -->
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <coverage>
        <report>
            <clover outputFile="storage/coverage/clover.xml"/>
            <text outputFile="php://stdout" showUncoveredFiles="false" showOnlySummary="true"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Issue #1488 : la config DB de test réelle est pgsql (voir .env.testing
             et tests/TestCase::configureTestingDatabaseConnection()).
             L'ancien binôme sqlite/:memory: était contredit par le TestCase et
             n'était jamais utilisé. Valeurs non forcées : l'env du runner prime. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="leopardo_test"/>
        <env name="DB_USERNAME" value="leopardo_user"/>
        <env name="DB_PASSWORD" value="leopardo_pass_test"/>
        <!-- Aligné sur la CI (tests.yml : DB_SEARCH_PATH=public,shared_tenants).
             L'ordre public,shared_tenants garantit que `CREATE TABLE migrations` atterrit
             dans public et que les migrations tenant sont correctement scoped (#1597). -->
        <env name="DB_SEARCH_PATH" value="public,shared_tenants"/>
        <!-- #7980 : le PostgreSQL de test (service CI / local) n'a pas de
             certificat TLS — la politique par défaut hors local est 'require',
             on l'explicite ici pour ne pas casser la suite. -->
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- #7696 : plus de fallback en dur dans config/demo.php — la valeur de test est explicite ici -->
        <env name="DEMO_PASSWORD" value="password123"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TRAVEL_PAYMENT_CALLBACK_SECRET" value="test-callback-secret"/>
        <!-- Webhooks fail-closed (#2614/#2615) : sans secret, Stripe/Chargily
             rejettent TOUT payload (400). Les tests Feature signent réellement
             les payloads avec ces secrets de test. -->
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_test_stripe_0123456789"/>
        <env name="CHARGILY_WEBHOOK_SECRET" value="whsec_test_chargily_0123456789"/>
    </php>
