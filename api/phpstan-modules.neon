parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: 3
    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: false

    excludePaths:
        - app/Core/Auth/Domain/Exceptions (?)
        - app/Core/Auth/Domain/Models/User.php (?)
        - app/Modules/Billing/Domain/Models (?)
        - app/Modules/Cabinet/Domain/Models (?)
        - app/Modules/Fleet/Domain/Models (?)
        - app/Modules/Payroll/Domain/Models (?)
        - app/Modules/Planning/Domain/Models (?)
        - app/Modules/Recruitment/Domain/Models (?)
        - app/Modules/Cameras/Infrastructure/Services (?)

    ignoreErrors:
        - '#App\\Http\\Controllers#'
        - '#App\\Services#'
        - '#App\\Models#'
        - '#Class App\\Modules\\(Planning|Payroll|HR|Billing|Recruitment|Fleet|Cabinet|Attendance)\\Domain\\Models\\Employee not found#'
        - '#Class App\\Modules\\(Planning|Fleet|Recruitment|Billing|Cabinet|Payroll|Attendance)\\Domain\\Models\\#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Factories\\Factory::(manager|managerRh|employee)\(\)#'
        - '#Using nullsafe method call on non-nullable type Illuminate\\Support\\Carbon#'
        - '#Strict comparison using (===|!==) between Illuminate\\Support\\Carbon and null#'
        - '#Strict comparison using (===|!==) between (string|float) and null#'
        - '#Class App\\Core\\Auth\\Domain\\Models\\(CompanyRequest|UserEmployeeLink) not found#'
        - '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$id#'
        - '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
        - '#Call to an undefined method Illuminate\\Database\\Query\\Builder::(with|whereKey)\(\)#'
        - '#Call to protected method increment\(\) of class Illuminate\\Database\\Eloquent\\Model#'
        - '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
        - '#Result of && is always false#'
        - '#Strict comparison using === between float and 3 will always evaluate to false#'
        - '#Left side of && is always true#'
        - '#Right side of && is always true#'
        - '#Comparison operation ">" between.*is always true#'
        - '#Call to function assert\(\) with true will always evaluate to true#'
        - '#Strict comparison using !== between null and null will always evaluate to false#'
        - '#Strict comparison using !== between string and int.null will always evaluate to true#'
        - '#Strict comparison using !== between string.null and int will always evaluate to true#'
        - '#Strict comparison using === between string.null and int will always evaluate to false#'
        - '#Call to an undefined method Illuminate\\Support\\Optional::toIso8601(String|ZuluString)\(\)#'
        - '#Access to property \$(company_id|id) on an unknown class App\\Modules\\Payroll\\Domain\\Models\\Employee#'
        - '#Call to method (resetToPrevious|setTenant|withinTenant)\(\) on an unknown class App\\Modules\\(HR|Attendance)\\Infrastructure\\Services\\TenantManager#'
        - '#Call to an undefined static method App\\Modules\\.*::create\(\)#'
        - '#Call to an undefined static method App\\Modules\\Cameras\\Domain\\(Camera|CameraAccessToken)::withoutGlobalScopes\(\)#'
        - '#Call to an undefined method App\\Modules\\(Attendance|Billing|Cabinet|Payroll)\\Infrastructure\\Services\\.*::(syncDevice|createSubscription|shareDocument|generateForPeriod)\(\)#'
        - '#Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem::download\(\)#'
        - '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::(belongsTo|hasMany|hasOne|belongsToMany)\(\)#'
        - '#Parameter \#1 \$related of method.*Eloquent\\Model::(belongsTo|hasMany|hasOne)\(\) expects class-string.*string given#'
        - '#Method App\\Modules\\Attendance\\Interfaces\\Api\\V1\\ApprovalController::(approve|reject)\(\) should return.*Resource but returns.*JsonResponse#'
        - '#Cannot call method (save|forceFill|update)\(\) on stdClass#'
        - '#Cannot access property \$.* on null#'
        - '#Access to an undefined property Illuminate\\Http\\Request::\$(employee_id|status|comment|reason)#'
        - '#Access to an undefined property App\\Modules\\Absence\\Domain\\Models\\LeaveBalance::\$absenceType#'
        - '#Property.*type has no value type specified in iterable type array#'
        - '#Method.*has parameter.*with no value type specified in iterable type array#'
        - '#Call to function is_array\(\) with array<mixed> will always evaluate to true#'
        - '#Expression on left side of \?\? is not nullable#'
        - '#Match expression does not handle remaining value: mixed#'
        - '#Parameter \#1 \$companyId of method App\\AI\\Workflows\\(PreparePayrollWorkflow|WeeklyReportWorkflow)::execute\(\) expects string, int\|null given#'
        - '#Unable to resolve the template type T(Value|Key) in call to function collect#'
        - '#Parameter \$dto of method App\\Modules\\Attendance\\Application\\Actions\\ProcessCheckIn::handle\(\) has invalid type#'
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*map\(\) contains unresolvable type#'
        - '#Method App\\Modules\\.*::.+\(\) has invalid return type App\\Modules\\#'
        - '#Method App\\Modules\\.*::.+\(\) should return Illuminate\\Database\\Eloquent\\Relations\\BelongsTo.*but returns#'
        - '#PHPDoc tag .@property-read. for property App\\Modules\\#'
        - '#Parameter .tenantManager of method App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\.*::__construct\(\) has invalid type#'
        - '#Property App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\.*::.*Manager has unknown class#'
        - '#Method App\\Modules\\.*::scope.*\(\) should return Illuminate\\Database\\Eloquent\\Builder.*but returns Illuminate\\Database\\Query\\Builder#'
        - '#Method App\\Modules\\.*::scope[A-Za-z]+\(\).*should return#'
        - '#Method App\\Modules\\Payroll\\Infrastructure\\Services\\PayrollService::validate\(\) invoked with 1 parameter, 2 required#'
        - '#Method App\\Modules\\Payroll\\Domain\\Contracts\\CountryRulesInterface::calculateIncomeTax\(\) invoked with 1 parameter, 2 required#'
        - '#Method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::reject\(\) invoked with 3 parameters, 2 required#'
        - '#Parameter .2 ..file of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects Illuminate\\Http\\UploadedFile, array given#'
        - '#Parameter .3 ..data of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects array<string, mixed>, string given#'
        - '#Parameter .1 ..companyId of method App\\Modules\\HR\\Interfaces\\Api\\V1\\OnboardingStepController::seedDefaultSteps\(\) expects string, int.null given#'
        - '#Parameter .2 ..companyId of method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::logBalanceChange\(\) expects string, int.null given#'
        - '#Parameter .1 ..companyId of method App\\Modules\\Payroll\\[A-Za-z]+\\[A-Za-z]+\\[A-Za-z]+::[A-Za-z]+\(\) expects string, int.null given#'
        - '#PHPDoc tag .@param. references unknown parameter: ..q#'
        - '#Parameter .1 ..callback of method Illuminate\\Support\\Collection<\(int.string\),mixed>::map\(\) contains unresolvable type#'
        - '#Unreachable statement - code above always terminates#'
        - '#Using nullsafe method call on non-nullable type Illuminate\\Support\\Optional#'
        - '#Method App\\Modules\\HR\\Domain\\Models\\Contract::scopeExpiringSoon\(\)#'
        - '#Method App\\Modules\\Billing\\Domain\\Models\\WebhookEndpoint::scopeListeningTo\(\)#'

    paths:
        - app/Core
        - app/Modules
        - app/Shared

        # Phase 3-4 — Nouveaux modules migrés depuis legacy
        - '#Class App\\Modules\\(Growth|Platform|Onboarding|Training)\\Domain\\Models\\#'
        - '#Access to an undefined property App\\Modules\\(Growth|Platform|Onboarding|Training)#'
        - '#Call to an undefined method App\\Modules\\(Growth|Platform|Onboarding|Training)#'
        - '#Parameter.*of method App\\Modules\\(Growth|Platform|Onboarding|Training).*invalid type#'
