includes:
    - phpstan-modules-baseline.neon

parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: 5
    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Legacy flat structure — tolérée pendant la migration DDD en cours
        - '#App\\Http\\Controllers#'
        - '#App\\Services#'
        - '#App\\Models#'
        # Cross-module references en cours de migration
        - '#Class App\\Modules\\(Planning|Payroll|HR|Billing|Recruitment|Fleet|Cabinet)\\Domain\\Models\\Employee not found#'
        # Erreurs Eloquent Factory génériques (factories DDD pas encore générées)
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Factories\\Factory::(manager|managerRh|employee)\(\)#'
        # Nullsafe Carbon — bruit de migration de types nullables
        - '#Using nullsafe method call on non-nullable type Illuminate\\Support\\Carbon#'
        # Exceptions DDD — extends DomainException résolu via autoload runtime
        - '#Class App\\Core\\Auth\\Domain\\Exceptions\\DomainException not found#'
        - '#extends unknown class App\\Core\\Auth\\Domain\\Exceptions\\DomainException#'
        - '#calls parent::__construct\(\) but .* does not extend any class#'
        # CompanyRequest / UserEmployeeLink — modèles en cours de migration
        - '#Class App\\Core\\Auth\\Domain\\Models\\(CompanyRequest|UserEmployeeLink) not found#'

    # Chemins à analyser — modules DDD uniquement, sans re-inclure app/ entier
    paths:
        - app/Core
        - app/Modules
        - app/Shared
