includes:
    - phpstan.neon

parameters:
    level: 6

    ignoreErrors:
        # Legacy flat structure — tolérée pendant la migration DDD en cours
        - '#App\\Http\\Controllers#'
        - '#App\\Services#'
        - '#App\\Models#'

    # Chemins à analyser en priorité (modules DDD uniquement)
    paths:
        - app/Core
        - app/Modules
        - app/Shared
