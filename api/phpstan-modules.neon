includes:
    - phpstan.neon

parameters:
    level: 6

    ignoreErrors:
        # Legacy flat structure — tolérée pendant la migration
        - '#App\\Http\\Controllers#'
        - '#App\\Services#'
        - '#App\\Models#'

    # Chemins à analyser en priorité
    paths:
        - api/app/Core
        - api/app/Modules
        - api/app/Shared
