# Régénération de phpstan-strict-baseline.neon — MIROIR EXACT du job
# « PHPStan — Strict » (architecture-check.yml) : includes phpstan.neon
# (bootstrap + phpstan-baseline.neon) + level 8 + paths Core/Modules/Shared,
# SANS l'inclusion de phpstan-strict-baseline.neon (c'est elle qu'on génère).
# Usage unique round 27 (issue #6818) — fichier supprimé après usage.
includes:
    - phpstan.neon

parameters:
    level: 8
    paths:
        - app/Core
        - app/Modules
        - app/Shared
