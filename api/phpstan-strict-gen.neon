# Configuration de RÉGÉNÉRATION de la baseline STRICT (round 27, PM
# 2026-09-05 — usage unique par .github/workflows/zz-gen-strict-baseline.yml).
# Périmètre = ce que voit réellement le job « PHPStan — Strict » : includes
# de phpstan.neon (paths app + routes + tests) fusionnés à
# phpstan-strict.neon (app/Core+Modules+Shared, niveau 8) → on analyse
# app + routes + tests au niveau 8. NB : n'inclut NI phpstan.neon NI les
# baselines — la baseline strict générée doit être un SUPERSET des erreurs
# restantes (les baselines main sont incluses par le job lui-même).
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - app
        - routes
        - tests
    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: false
