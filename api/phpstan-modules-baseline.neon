parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$file of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService\:\:uploadDocument\(\) expects Illuminate\\Http\\UploadedFile, array given\.$#'
			identifier: argument.type
			count: 1
			path: app/Modules/Cabinet/Application/Actions/UploadDocument.php

		-
			message: '#^Parameter \#3 \$data of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService\:\:uploadDocument\(\) expects array\<string, mixed\>, string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Modules/Cabinet/Application/Actions/UploadDocument.php

		-
			message: '#^Property App\\Modules\\Cameras\\Interfaces\\Api\\V1\\Controllers\\PublicCameraViewerController\:\:\$cameras is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: app/Modules/Cameras/Interfaces/Api/V1/Controllers/PublicCameraViewerController.php

		-
			message: '#^Parameter \#1 \$array \(array\{''required'', ''integer'', ''min\:1''\|Illuminate\\Validation\\Rules\\In\}\) to function array_filter does not contain falsy values, the array will always stay the same\.$#'
			identifier: arrayFilter.same
			count: 1
			path: app/Modules/Cameras/Interfaces/Api/V1/Requests/StoreCameraAccessTokenRequest.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: app/Modules/EdgeSync/Domain/Models/EdgeNode.php

		-
			message: '#^Offset ''days_worked'' on array\{employee_id\: int, num_cnss\: string, last_name\: string, first_name\: string, cin\: string, gross_salary\: float, days_worked\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Modules/Payroll/Infrastructure/Services/SocialDeclarationGenerator.php

