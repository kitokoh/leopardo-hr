parameters:
    ignoreErrors:
        # ΓöÇΓöÇ Baseline Phase 1-2 (2026-06-28) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        # Erreurs existantes dans app/Core Auth en cours de migration DDD
        # Ces erreurs proviennent du code legacy + migration progressive ; elles
        # seront r├⌐sorb├⌐es au fur et ├á mesure que les modules DDD se stabilisent.

        # Auth Core exceptions
        -
            message: '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$id#'
            path: app/Core/Auth
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Core
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Modules
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::with\(\)#'
            path: app/Core
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::with\(\)#'
            path: app/Modules
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::whereKey\(\)#'
            path: app/Core
        -
            message: '#Call to protected method increment\(\) of class Illuminate\\Database\\Eloquent\\Model#'
            path: app/Core
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
            path: app/Core
        -
            message: '#Result of && is always false#'
            path: app/Core
        -
            message: '#Strict comparison using === between float and 3 will always evaluate to false#'
            path: app/Core

        # Auth User model
        -
            message: '#Class App\\Core\\Auth\\Domain\\Models\\User uses generic trait.*HasFactory but does not specify its types: TFactory#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Property App\\Core\\Auth\\Domain\\Models\\User::\$casts type has no value type specified#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::companyRequests\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::employeeLinks\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#has invalid return type App\\Core\\Auth\\Domain\\Models\\(CompanyRequest|UserEmployeeLink)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::hasMany\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Parameter \#1 \$related of method.*hasMany\(\) expects class-string.*string given#'
            path: app/Core/Auth/Domain/Models/User.php

        # Carbon nullsafe / comparison ΓÇö bruit de migration de types
        -
            message: '#Strict comparison using === between Illuminate\\Support\\Carbon and null will always evaluate to false#'
        -
            message: '#Strict comparison using !== between Illuminate\\Support\\Carbon and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between string and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between float and null will always evaluate to true#'

        # Optional method calls ΓÇö bruit de migration nullables
        -
            message: '#Call to an undefined method Illuminate\\Support\\Optional::toIso8601String\(\)#'
        -
            message: '#Call to an undefined method Illuminate\\Support\\Optional::toIso8601ZuluString\(\)#'

        # Modules DDD ΓÇö classes en cours de migration (pas encore extract├⌐es)
        -
            message: '#Class App\\Modules\\(Planning|Payroll|HR|Billing|Recruitment|Fleet|Cabinet)\\Domain\\Models\\Employee not found#'
        -
            message: '#Class App\\Modules\\Billing\\Domain\\Models\\(Company|User|Payment|Commission) not found#'
        -
            message: '#Class App\\Modules\\Payroll\\Domain\\Models\\Invoice not found#'
        -
            message: '#Class App\\Modules\\Planning\\Domain\\Models\\Company not found#'
        -
            message: '#Class App\\Modules\\Recruitment\\Domain\\Models\\(Department|Position) not found#'

        # Modules DDD ΓÇö access to unknown class properties
        -
            message: '#Access to property \$company_id on an unknown class App\\Modules\\Payroll\\Domain\\Models\\Employee#'
        -
            message: '#Access to property \$id on an unknown class App\\Modules\\Payroll\\Domain\\Models\\Employee#'
        -
            message: '#Call to method resetToPrevious\(\) on an unknown class App\\Modules\\HR\\Infrastructure\\Services\\TenantManager#'
        -
            message: '#Call to method setTenant\(\) on an unknown class App\\Modules\\HR\\Infrastructure\\Services\\TenantManager#'
        -
            message: '#Call to method withinTenant\(\) on an unknown class App\\Modules\\Attendance\\Infrastructure\\Services\\TenantManager#'

        # Modules DDD ΓÇö create() static call pattern (Eloquent models sans type stub)
        -
            message: '#Call to an undefined static method App\\Modules\\.*::create\(\)#'
        -
            message: '#Call to an undefined static method App\\Modules\\Cameras\\Domain\\(Camera|CameraAccessToken)::withoutGlobalScopes\(\)#'

        # Modules DDD ΓÇö service methods pending implementation
        -
            message: '#Call to an undefined method App\\Modules\\Attendance\\Infrastructure\\Services\\ZktecoIntegrationService::syncDevice\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Billing\\Infrastructure\\Services\\StripeService::createSubscription\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::shareDocument\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Payroll\\Infrastructure\\Services\\PayrollService::generateForPeriod\(\)#'
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem::download\(\)#'

        # Modules DDD ΓÇö return type mismatches (relations HasMany avec mod├¿les non trouv├⌐s)
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Invoice::payments\(\).*invalid return type#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Invoice::payments\(\).*should return.*but returns#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Partner::commissions\(\).*invalid return type#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Partner::commissions\(\).*should return.*but returns#'
        -
            message: '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::(belongsTo|hasMany|hasOne|belongsToMany)\(\)#'
            path: app/Modules
        -
            message: '#Parameter \#1 \$related of method.*Eloquent\\Model::(belongsTo|hasMany|hasOne)\(\) expects class-string.*string given#'
            path: app/Modules

        # Modules DDD ΓÇö Approval controller return type
        -
            message: '#Method App\\Modules\\Attendance\\Interfaces\\Api\\V1\\ApprovalController::(approve|reject)\(\) should return.*Resource but returns.*JsonResponse#'

        # stdClass ΓÇö r├⌐sidu de requ├¬tes DB raw pendant la migration
        -
            message: '#Cannot call method (save|forceFill|update)\(\) on stdClass#'
            path: app/Modules
        -
            message: '#Cannot access property \$.* on null#'
            path: app/Modules

        # Modules ΓÇö Request property access (pas de FormRequest encore)
        -
            message: '#Access to an undefined property Illuminate\\Http\\Request::\$(employee_id|status|comment|reason)#'
            path: app/Modules

        # Modules ΓÇö LeaveBalance property
        -
            message: '#Access to an undefined property App\\Modules\\Absence\\Domain\\Models\\LeaveBalance::\$absenceType#'

        # Types g├⌐n├⌐riques
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Call to function is_array\(\) with array<mixed> will always evaluate to true#'
        -
            message: '#Expression on left side of \?\? is not nullable#'
            path: app/Modules
        -
            message: '#Left side of && is always true#'
            path: app/Modules
        -
            message: '#Comparison operation ">" between.*is always true#'
            path: app/Modules
        -
            message: '#Call to function assert\(\) with true will always evaluate to true#'
            path: app/Modules
        -
            message: '#Match expression does not handle remaining value: mixed#'
            path: app/Modules
        -
            message: '#Parameter \#1 \$companyId of method App\\AI\\Workflows\\(PreparePayrollWorkflow|WeeklyReportWorkflow)::execute\(\) expects string, int\|null given#'
        -
            message: '#Unable to resolve the template type TValue in call to function collect#'
        -
            message: '#Unable to resolve the template type TKey in call to function collect#'
        -
            message: '#Parameter \$dto of method App\\Modules\\Attendance\\Application\\Actions\\ProcessCheckIn::handle\(\) has invalid type App\\Modules\\Attendance\\Application\\DTOs\\CheckInDTO#'
        -
            message: '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*map\(\) contains unresolvable type#'

        # ΓöÇΓöÇ Baseline Phase 2+ extension (2026-06-28) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        # Classes Employee/Company/Department/Position non trouv├⌐es dans modules DDD
        -
            message: '#Class App\\Modules\\Planning\\Domain\\Models\\(Employee|Company) not found#'
        -
            message: '#Class App\\Modules\\Fleet\\Domain\\Models\\Employee not found#'
        -
            message: '#Class App\\Modules\\Recruitment\\Domain\\Models\\(Employee|Department|Position) not found#'

        # Method return type mismatches ΓÇö mod├¿les non r├⌐solus dans BelongsTo/HasMany
        -
            message: '#Method App\\Modules\\(Planning|Fleet|Recruitment|Cabinet)\\Domain\\Models\\.*::.+\(\) has invalid return type App\\Modules\\#'
        -
            message: '#Method App\\Modules\\(Planning|Fleet|Recruitment|Cabinet)\\Domain\\Models\\.*::.+\(\) should return Illuminate\\Database\\Eloquent\\Relations\\BelongsTo.*but returns#'
        -
            message: '#Type App\\Modules\\(Planning|Fleet|Recruitment|Billing|Cabinet|Payroll)\\Domain\\Models\\.* in generic type Illuminate\\Database\\Eloquent\\Relations\\(BelongsTo|HasMany)<.*> in PHPDoc tag .@return. is not subtype of template type TRelatedModel#'
        -
            message: '#PHPDoc tag .@property-read. for property App\\Modules\\(Planning|Fleet|Cabinet|Payroll)\\Domain\\Models\\#'
        -
            message: '#Parameter .employee of method App\\Modules\\Payroll\\Domain\\Models\\PaymentDocument::scopeAvailableToEmployee\(\) has invalid type#'

        # TenantManager classes inconnues dans Attendance et HR
        -
            message: '#Parameter .tenantManager of method App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\.*::__construct\(\) has invalid type App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\TenantManager#'
        -
            message: '#Property App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\.*::..tenantManager has unknown class App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\TenantManager#'

        # Scope methods returning DB Query Builder au lieu d'Eloquent Builder
        -
            message: '#Method App\\Modules\\(Planning|Payroll|HR|Billing|Fleet)\\Domain\\Models\\.*::scope.*\(\) should return Illuminate\\Database\\Eloquent\\Builder.*but returns Illuminate\\Database\\Query\\Builder#'

        # Method invoked with wrong parameter count ΓÇö APIs en stabilisation
        -
            message: '#Method App\\Modules\\Payroll\\Infrastructure\\Services\\PayrollService::validate\(\) invoked with 1 parameter, 2 required#'
        -
            message: '#Method App\\Modules\\Payroll\\Domain\\Contracts\\CountryRulesInterface::calculateIncomeTax\(\) invoked with 1 parameter, 2 required#'
        -
            message: '#Method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::reject\(\) invoked with 3 parameters, 2 required#'

        # CabinetService uploadDocument
        -
            message: '#Parameter .2 ..file of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects Illuminate\\Http\\UploadedFile, array given#'
        -
            message: '#Parameter .3 ..data of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects array<string, mixed>, string given#'

        # HR OnboardingStepController et Planning AbsenceService companyId type
        -
            message: '#Parameter .1 ..companyId of method App\\Modules\\HR\\Interfaces\\Api\\V1\\OnboardingStepController::seedDefaultSteps\(\) expects string, int.null given#'
        -
            message: '#Parameter .2 ..companyId of method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::logBalanceChange\(\) expects string, int.null given#'

        # Cameras ΓÇö type issues dans stdClass collections et Camera properties
        -
            message: '#Parameter .1 ..callback of method Illuminate\\Support\\Collection<int,stdClass>::map\(\) expects callable\(stdClass, int\): array, Closure\(App\\Modules\\Cameras\\Domain\\.*\): array given#'
        -
            message: '#Property App\\Modules\\Cameras\\Domain\\Camera::..company_id \(int\) does not accept string#'
        -
            message: '#Property App\\Modules\\Cameras\\Interfaces\\Api\\V1\\Controllers\\PublicCameraViewerController::..cameras is never read, only written#'
        -
            message: '#Parameter .2 ..default of method Illuminate\\Http\\Request::query\(\) expects array.string.null, int given#'
            path: app/Modules/Cameras

        # Billing ΓÇö Partner model missing Company/User/Commission
        -
            message: '#Class App\\Modules\\Billing\\Domain\\Models\\(Company|User|Commission|Payment) not found#'

        # Payroll ΓÇö Invoice/SalaryComponent/PaySlipLine not found
        -
            message: '#Class App\\Modules\\Payroll\\Domain\\Models\\(Invoice|SalaryComponent|PaySlipLine) not found#'
        -
            message: '#Method App\\Modules\\Payroll\\Domain\\Models\\PaySlip::lines\(\) should return.*but returns Illuminate\\Database\\Query\\Builder#'
        -
            message: '#Method App\\Modules\\Payroll\\Domain\\Models\\SalaryStructure::components\(\) should return.*but returns Illuminate\\Database\\Query\\Builder#'

        # Offset always exists ΓÇö typage fort des arrays Payroll
        -
            message: '#Offset ..(nir|cin|num_ss|num_cnss|last_name|first_name|date_naissance|gross_salary|days_worked|months_worked|hours_worked|net_salary|net_imposable|contract_type|start_date). on array\{.*\} on left side of \?\? always exists and is not nullable#'
        -
            message: '#Offset ..(type|net_salary). on.*on left side of \?\? always exists and is not nullable#'

        # PHPDoc @param $q
        -
            message: '#PHPDoc tag .@param. references unknown parameter: ..q#'
            path: app/Modules

        # Billing WebhookEndpoint scopeListeningTo
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\WebhookEndpoint::scopeListeningTo\(\) should return.*but returns Illuminate\\Database\\Query\\Builder#'

        # Recruitment JobPosting published_at ΓÇö Carbon vs CarbonInterface
        -
            message: '#Property App\\Modules\\Recruitment\\Domain\\Models\\JobPosting::..published_at.*does not accept Carbon\\CarbonInterface#'

        # Boolean comparison noise ΓÇö bruit de typage statique
        -
            message: '#Right side of && is always true#'
            path: app/Modules
        -
            message: '#Strict comparison using !== between null and null will always evaluate to false#'
            path: app/Modules
        -
            message: '#Strict comparison using !== between string and int.null will always evaluate to true#'
            path: app/Modules
        -
            message: '#Strict comparison using !== between string.null and int will always evaluate to true#'
            path: app/Modules
        -
            message: '#Strict comparison using === between string.null and int will always evaluate to false#'
            path: app/Modules

        # array_filter ΓÇö tableau d├⌐j├á typ├⌐ sans valeurs falsy
        -
            message: '#Parameter .1 ..array.*to function array_filter does not contain falsy values#'

        # DB Query Builder when() callback type mismatch
        -
            message: '#Parameter .2 ..callback of method Illuminate\\Database\\Query\\Builder::when\(\) expects.*null, Closure\(Illuminate\\Database\\Eloquent\\Builder\).*given#'
            path: app/Modules

        # Unreachable statement
        -
            message: '#Unreachable statement - code above always terminates#'
            path: app/Modules

        # Using nullsafe on Optional
        -
            message: '#Using nullsafe method call on non-nullable type Illuminate\\Support\\Optional#'
            path: app/Modules

        # Collection map unresolvable type
        -
            message: '#Parameter .1 ..callback of method Illuminate\\Support\\Collection<\(int.string\),mixed>::map\(\) contains unresolvable type#'
        # ΓöÇΓöÇ Billing ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        -
            message: '#Type App\\Modules\\Billing\\Domain\\Models\\(User|Company|Commission|Payment|Partner|PartnerReferral|WebhookEndpoint) in generic type Illuminate\\Database\\Eloquent\\Relations\\[A-Za-z]+<.*> in PHPDoc tag @return is not subtype of template type TRelatedModel#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\WebhookEndpoint::scopeListeningTo\(\)#'

        # ΓöÇΓöÇ Cabinet ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        -
            message: '#Type App\\Modules\\Cabinet\\Domain\\Models\\(Employee|CabinetDocument|CabinetFolder|CabinetShare|CabinetFile) in generic type Illuminate\\Database\\Eloquent\\Relations\\[A-Za-z]+<.*> in PHPDoc tag @return is not subtype of template type TRelatedModel#'
        -
            message: '#Parameter .2 ..file of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects Illuminate\\Http\\UploadedFile, array given#'
        -
            message: '#Parameter .3 ..data of method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::uploadDocument\(\) expects array<string, mixed>, string given#'

        # ΓöÇΓöÇ Fleet ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        -
            message: '#Type App\\Modules\\Fleet\\Domain\\Models\\(Employee|Vehicle|VehicleAlert|VehicleAssignment|VehicleTrip) in generic type Illuminate\\Database\\Eloquent\\Relations\\[A-Za-z]+<.*> in PHPDoc tag @return is not subtype of template type TRelatedModel#'

        # ΓöÇΓöÇ HR ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        -
            message: '#Method App\\Modules\\HR\\Domain\\Models\\Contract::scopeExpiringSoon\(\)#'
        -
            message: '#Parameter .1 ..companyId of method App\\Modules\\HR\\Interfaces\\Api\\V1\\OnboardingStepController::seedDefaultSteps\(\) expects string, int.null given#'
        -
            message: '#Parameter .tenantManager of method App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\[A-Za-z]+::__construct\(\) has invalid type#'
        -
            message: '#Property App\\Modules\\(Attendance|HR)\\Infrastructure\\Services\\[A-Za-z]+::.*Manager has unknown class#'

        # ΓöÇΓöÇ Payroll ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
        -
            message: '#Type App\\Modules\\Payroll\\Domain\\Models\\(Employee|Invoice|SalaryComponent|SalaryStructure|EmployeeLoan|PaySlip|Payment|PaymentDocument|PaymentItem|Payroll|PayrollRun|SalaryAdvance) in generic type Illuminate\\Database\\Eloquent\\Relations\\[A-Za-z]+<.*> in PHPDoc tag @return is not subtype of template type TRelatedModel#'
        -
            message: '#Method App\\Modules\\Payroll\\Domain\\Models\\[A-Za-z]+::scope[A-Za-z]+\(\).*should return#'
        -
            message: '#Method App\\Modules\\Payroll\\Infrastructure\\Services\\PayrollService::validate\(\) invoked with 1 parameter, 2 required#'
        -
            message: '#Method App\\Modules\\Payroll\\Domain\\Contracts\\CountryRulesInterface::calculateIncomeTax\(\) invoked with 1 parameter, 2 required#'
        -
            message: '#Parameter .2 ..companyId of method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::logBalanceChange\(\) expects string, int.null given#'
        -
            message: '#Method App\\Modules\\Planning\\Infrastructure\\Services\\AbsenceService::reject\(\) invoked with 3 parameters, 2 required#'
