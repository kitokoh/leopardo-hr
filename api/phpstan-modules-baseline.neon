parameters:
    ignoreErrors:
        # ── Baseline Phase 1-2 (2026-06-28) ─────────────────────────────────────
        # Erreurs existantes dans app/Core Auth en cours de migration DDD
        # Ces erreurs proviennent du code legacy + migration progressive ; elles
        # seront résorbées au fur et à mesure que les modules DDD se stabilisent.

        # Auth Core exceptions
        -
            message: '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$id#'
            path: app/Core/Auth
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Core
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Modules
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::with\(\)#'
            path: app/Core
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::with\(\)#'
            path: app/Modules
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::whereKey\(\)#'
            path: app/Core
        -
            message: '#Call to protected method increment\(\) of class Illuminate\\Database\\Eloquent\\Model#'
            path: app/Core
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
            path: app/Core
        -
            message: '#Result of && is always false#'
            path: app/Core
        -
            message: '#Strict comparison using === between float and 3 will always evaluate to false#'
            path: app/Core

        # Auth User model
        -
            message: '#Class App\\Core\\Auth\\Domain\\Models\\User uses generic trait.*HasFactory but does not specify its types: TFactory#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Property App\\Core\\Auth\\Domain\\Models\\User::\$casts type has no value type specified#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::companyRequests\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::employeeLinks\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#has invalid return type App\\Core\\Auth\\Domain\\Models\\(CompanyRequest|UserEmployeeLink)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::hasMany\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Parameter \#1 \$related of method.*hasMany\(\) expects class-string.*string given#'
            path: app/Core/Auth/Domain/Models/User.php

        # Carbon nullsafe / comparison — bruit de migration de types
        -
            message: '#Strict comparison using === between Illuminate\\Support\\Carbon and null will always evaluate to false#'
        -
            message: '#Strict comparison using !== between Illuminate\\Support\\Carbon and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between string and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between float and null will always evaluate to true#'

        # Optional method calls — bruit de migration nullables
        -
            message: '#Call to an undefined method Illuminate\\Support\\Optional::toIso8601String\(\)#'
        -
            message: '#Call to an undefined method Illuminate\\Support\\Optional::toIso8601ZuluString\(\)#'

        # Modules DDD — classes en cours de migration (pas encore extractées)
        -
            message: '#Class App\\Modules\\(Planning|Payroll|HR|Billing|Recruitment|Fleet|Cabinet)\\Domain\\Models\\Employee not found#'
        -
            message: '#Class App\\Modules\\Billing\\Domain\\Models\\(Company|User|Payment|Commission) not found#'
        -
            message: '#Class App\\Modules\\Payroll\\Domain\\Models\\Invoice not found#'
        -
            message: '#Class App\\Modules\\Planning\\Domain\\Models\\Company not found#'
        -
            message: '#Class App\\Modules\\Recruitment\\Domain\\Models\\(Department|Position) not found#'

        # Modules DDD — access to unknown class properties
        -
            message: '#Access to property \$company_id on an unknown class App\\Modules\\Payroll\\Domain\\Models\\Employee#'
        -
            message: '#Access to property \$id on an unknown class App\\Modules\\Payroll\\Domain\\Models\\Employee#'
        -
            message: '#Call to method resetToPrevious\(\) on an unknown class App\\Modules\\HR\\Infrastructure\\Services\\TenantManager#'
        -
            message: '#Call to method setTenant\(\) on an unknown class App\\Modules\\HR\\Infrastructure\\Services\\TenantManager#'
        -
            message: '#Call to method withinTenant\(\) on an unknown class App\\Modules\\Attendance\\Infrastructure\\Services\\TenantManager#'

        # Modules DDD — create() static call pattern (Eloquent models sans type stub)
        -
            message: '#Call to an undefined static method App\\Modules\\.*::create\(\)#'
        -
            message: '#Call to an undefined static method App\\Modules\\Cameras\\Domain\\(Camera|CameraAccessToken)::withoutGlobalScopes\(\)#'

        # Modules DDD — service methods pending implementation
        -
            message: '#Call to an undefined method App\\Modules\\Attendance\\Infrastructure\\Services\\ZktecoIntegrationService::syncDevice\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Billing\\Infrastructure\\Services\\StripeService::createSubscription\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Cabinet\\Infrastructure\\Services\\CabinetService::shareDocument\(\)#'
        -
            message: '#Call to an undefined method App\\Modules\\Payroll\\Infrastructure\\Services\\PayrollService::generateForPeriod\(\)#'
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem::download\(\)#'

        # Modules DDD — return type mismatches (relations HasMany avec modèles non trouvés)
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Invoice::payments\(\).*invalid return type#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Invoice::payments\(\).*should return.*but returns#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Partner::commissions\(\).*invalid return type#'
        -
            message: '#Method App\\Modules\\Billing\\Domain\\Models\\Partner::commissions\(\).*should return.*but returns#'
        -
            message: '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::(belongsTo|hasMany|hasOne|belongsToMany)\(\)#'
            path: app/Modules
        -
            message: '#Parameter \#1 \$related of method.*Eloquent\\Model::(belongsTo|hasMany|hasOne)\(\) expects class-string.*string given#'
            path: app/Modules

        # Modules DDD — Approval controller return type
        -
            message: '#Method App\\Modules\\Attendance\\Interfaces\\Api\\V1\\ApprovalController::(approve|reject)\(\) should return.*Resource but returns.*JsonResponse#'

        # stdClass — résidu de requêtes DB raw pendant la migration
        -
            message: '#Cannot call method (save|forceFill|update)\(\) on stdClass#'
            path: app/Modules
        -
            message: '#Cannot access property \$.* on null#'
            path: app/Modules

        # Modules — Request property access (pas de FormRequest encore)
        -
            message: '#Access to an undefined property Illuminate\\Http\\Request::\$(employee_id|status|comment|reason)#'
            path: app/Modules

        # Modules — LeaveBalance property
        -
            message: '#Access to an undefined property App\\Modules\\Absence\\Domain\\Models\\LeaveBalance::\$absenceType#'

        # Types génériques
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Call to function is_array\(\) with array<mixed> will always evaluate to true#'
        -
            message: '#Expression on left side of \?\? is not nullable#'
            path: app/Modules
        -
            message: '#Left side of && is always true#'
            path: app/Modules
        -
            message: '#Comparison operation ">" between.*is always true#'
            path: app/Modules
        -
            message: '#Call to function assert\(\) with true will always evaluate to true#'
            path: app/Modules
        -
            message: '#Match expression does not handle remaining value: mixed#'
            path: app/Modules
        -
            message: '#Parameter \#1 \$companyId of method App\\AI\\Workflows\\(PreparePayrollWorkflow|WeeklyReportWorkflow)::execute\(\) expects string, int\|null given#'
        -
            message: '#Unable to resolve the template type TValue in call to function collect#'
        -
            message: '#Unable to resolve the template type TKey in call to function collect#'
        -
            message: '#Parameter \$dto of method App\\Modules\\Attendance\\Application\\Actions\\ProcessCheckIn::handle\(\) has invalid type App\\Modules\\Attendance\\Application\\DTOs\\CheckInDTO#'
        -
            message: '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*map\(\) contains unresolvable type#'
