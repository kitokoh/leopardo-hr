parameters:
    ignoreErrors:
        # Baseline auto-générée — Phase 1 (2026-06-28)
        # Erreurs existantes dans app/Core Auth en cours de migration DDD
        -
            message: '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$id#'
            path: app/Core/Auth
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Core
        -
            message: '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
            path: app/Modules
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::with\(\)#'
            path: app/Core
        -
            message: '#Call to an undefined method Illuminate\\Database\\Query\\Builder::whereKey\(\)#'
            path: app/Core
        -
            message: '#Call to protected method increment\(\) of class Illuminate\\Database\\Eloquent\\Model#'
            path: app/Core
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
            path: app/Core
        -
            message: '#Result of && is always false#'
            path: app/Core
        -
            message: '#Strict comparison using === between float and 3 will always evaluate to false#'
            path: app/Core
        -
            message: '#Class App\\Core\\Auth\\Domain\\Models\\User uses generic trait.*HasFactory but does not specify its types: TFactory#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Property App\\Core\\Auth\\Domain\\Models\\User::\$casts type has no value type specified#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::companyRequests\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Method App\\Core\\Auth\\Domain\\Models\\User::employeeLinks\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#has invalid return type App\\Core\\Auth\\Domain\\Models\\(CompanyRequest|UserEmployeeLink)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Unable to resolve the template type TRelatedModel in call to method Illuminate\\Database\\Eloquent\\Model::hasMany\(\)#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Parameter \#1 \$related of method.*hasMany\(\) expects class-string.*string given#'
            path: app/Core/Auth/Domain/Models/User.php
        -
            message: '#Offset .* on array\{.*\} on left side of \?\? always exists and is not nullable#'
            path: app/Core
        -
            message: '#Strict comparison using === between Illuminate\\Support\\Carbon and null will always evaluate to false#'
            path: app/Core
        -
            message: '#Strict comparison using !== between string and int\|null will always evaluate to true#'
            path: app/Core
        -
            message: '#Parameter \#1 \$companyId of method App\\AI\\Workflows\\(PreparePayrollWorkflow|WeeklyReportWorkflow)::execute\(\) expects string, int\|null given#'
            path: app/Core
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Property.*type has no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Core
        -
            message: '#Method.*has parameter.*with no value type specified in iterable type array#'
            path: app/Modules
        -
            message: '#Call to function is_array\(\) with array<mixed> will always evaluate to true#'
            path: app/Core
        -
            message: '#Strict comparison using !== between Illuminate\\Support\\Carbon and null will always evaluate to true#'
            path: app/Modules
        -
            message: '#Strict comparison using !== between Illuminate\\Support\\Carbon and null will always evaluate to true#'
            path: app/Core
