# ──────────────────────────────────────────────────────────────────────────────
# Stage 1 — Build Laravel Vite/Tailwind assets
# ──────────────────────────────────────────────────────────────────────────────
# Le portail blade (login manager, login super admin, /docs, /api-explorer, …)
# charge ses assets via @vite() dans layouts/app.blade.php. Sans
# public/build/manifest.json compilé, le portail est servi SANS aucun style en
# production (page blanche brute). Cette étape compile app.css (Tailwind) et
# app.js une seule fois à la construction de l'image.
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js postcss.config.js tailwind.config.js ./
COPY resources ./resources
RUN npm run build

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2 — Laravel runtime (FrankenPHP)
# ──────────────────────────────────────────────────────────────────────────────
# Base image with FrankenPHP and PHP 8.4
FROM dunglas/frankenphp:php8.4-alpine

# Laravel runtime defaults
ENV APP_ENV=production
ENV APP_DEBUG=false
ENV LOG_CHANNEL=stderr
ENV RUN_MIGRATIONS=true

# Required PHP extensions
RUN install-php-extensions \
    pcntl \
    pdo_pgsql \
    gd \
    intl \
    zip \
    bcmath \
    opcache \
    redis

WORKDIR /app

# Build context is the monorepo root (render.yaml: dockerContext: .) so
# shared/i18n can be shipped into the image. Only api/ is copied to /app
# (the root .dockerignore excludes front/, docs/, tests/, ...).
COPY api/ .

# I18nCatalog::rootPath() reads <repo-root>/shared/i18n = /shared/i18n.
# Without this copy, GET /api/v1/i18n/catalog/* 500s in production
# (Locale catalog not found). See issue #1773.
COPY shared/i18n /shared/i18n
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN composer install --no-dev --no-interaction --no-progress --optimize-autoloader

# Assets Vite/Tailwind compilés au stage 1 (public/build est gitignoré :
# sans cette copie, le portail blade serait servi non stylé).
COPY --from=assets /app/public/build /app/public/build

# Keep config cache generation for runtime, not build-time.
RUN chown -R www-data:www-data storage bootstrap/cache

# Render/Heroku no-new-privs compatibility for frankenphp binary.
RUN cp /usr/local/bin/frankenphp /usr/local/bin/frankenphp-nocap \
    && mv /usr/local/bin/frankenphp-nocap /usr/local/bin/frankenphp

EXPOSE 80 443 2019 8080

COPY api/Caddyfile /etc/caddy/Caddyfile
COPY --chmod=755 api/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
