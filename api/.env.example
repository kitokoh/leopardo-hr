APP_NAME="Leopardo RH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.leopardo-rh.com
FRONTEND_URL=https://app.leopardo-rh.com
APP_TIMEZONE=UTC
# Version semver exposee par /api/v1/health (doit suivre CHANGELOG.md).
# Peut etre injectee au deploy depuis un CI var (ex : commit court).
APP_VERSION=4.16.17

# Demo/seed credentials endpoint (/api/v1/demo-users). MUST stay false/unset in
# production. Only set to true on isolated staging/demo environments that seed
# throwaway demo tenants.
DEMO_MODE_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leopardo_db
DB_USERNAME=leopardo_user
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE_EN_PROD
DB_SEARCH_PATH=shared_tenants,public

# Redis — Upstash (TLS requis)
REDIS_CLIENT=predis
# Upstash Redis (TLS required — get from https://console.upstash.com)
REDIS_URL=rediss://default:VOTRE_PASSWORD_UPSTASH@VOTRE_HOST.upstash.io:6379
REDIS_HOST=VOTRE_HOST.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=VOTRE_PASSWORD_UPSTASH
REDIS_USERNAME=default

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=VOTRE_USERNAME_SMTP
MAIL_PASSWORD=VOTRE_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@leopardo-rh.com
MAIL_FROM_NAME="Leopardo RH"

SANCTUM_STATEFUL_DOMAINS=app.leopardo-rh.com,localhost
SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://app.leopardo-rh.com,https://leopardo-rh.com

DOMPDF_PAPER_SIZE=A4
DOMPDF_ENABLE_REMOTE=false

FILESYSTEM_DISK=local

BACKUP_PATH=/var/backups/leopardo
BACKUP_KEEP_LAST=10

TELESCOPE_ENABLED=false
RATE_LIMIT_API=60
TENANCY_DEFAULT_TYPE=shared

# Super Admin (cree par SuperAdminSeeder a la 1ere execution de `php artisan leopardo:migrate --seed`)
# - Se connecte sur /platform/login (web) ou POST /api/v1/platform/auth/login (API)
# - Si SUPER_ADMIN_PASSWORD est vide, le seeder genere un mot de passe aleatoire affiche dans les logs
# - Pour changer le mot de passe a tout moment :
#     php artisan super-admin:reset-password admin@leopardo-rh.com NouveauMotDePasse
SUPER_ADMIN_EMAIL=admin@leopardo-rh.com
SUPER_ADMIN_PASSWORD=
FORCE_SUPER_ADMIN_PASSWORD_RESET=false

# Stripe — Payment provider for subscriptions
# Get your keys at https://dashboard.stripe.com/apikeys
# Create Price IDs in the Stripe Dashboard for each plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Chargily — Payment provider for Algeria (CIB, BaridiMob)
# https://dev.chargily.com/
CHARGILY_API_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_MODE=live

AYRSHARE_API_KEY=
AYRSHARE_BASE_URL=https://api.ayrshare.com/api

# Google OAuth (Laravel Socialite) — required for /auth/google, /auth/google/callback, /auth/google/token
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.leopardo-rh.com/api/v1/auth/google/callback

# Firebase / FCM — Push notifications (mobile + admin SSE fallback)
# https://console.firebase.google.com/ > Project Settings > Service Accounts
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=leopardo-rh
# Coller ici le JSON complet de la service account (format minifie sur une ligne)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ═══════════════════════════════════════════════════════════════════
#  Clés additionnelles — parité config/ ↔ .env.example (issue #1487)
#  Générées depuis api/config/*.php. Les clés secrètes sont à remplir.
# ═══════════════════════════════════════════════════════════════════

# --- config/cors.php ---
ADMIN_DASHBOARD_URL=
CORS_EXTRA_ORIGIN=

# --- config/ai.php ---
AI_AGENT_MAX_STEPS=10
AI_ENABLED=false
AI_MAX_TOKENS=1024
AI_MODEL=gpt-4o
AI_PENDING_ACTION_TTL_MINUTES=15
AI_PROVIDER=openai
AI_STT_PROVIDER=whisper
AI_TEMPERATURE=0.3
AI_TTS_PROVIDER=edge_tts
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- config/app.php ---
APP_FAKER_LOCALE=en_US
APP_FALLBACK_LOCALE=en
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# --- config/auth.php ---
AUTH_GUARD=sanctum
AUTH_MODEL=Employee::class
AUTH_PASSWORD_BROKER=employees
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

# --- config/cache.php ---
AWS_ACCESS_KEY_ID=
AWS_DEFAULT_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
CACHE_PREFIX=Str::slug(env('APP_NAME', 'laravel
DB_CACHE_CONNECTION=
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
DB_CACHE_TABLE=cache
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# --- config/filesystems.php ---
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- config/queue.php ---
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE_RETRY_AFTER=90
DB_QUEUE=default
DB_QUEUE_CONNECTION=
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_TABLE=jobs
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_DOCUMENTS_RETRY_AFTER=300
REDIS_QUEUE_RETRY_AFTER=90
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=

# --- config/cameras.php ---
CAMERAS_ACCESS_TOKEN_MAX=30 * 24 * 60
CAMERAS_DEFAULT_MAX=0
CAMERAS_FFPROBE_BIN=ffprobe
CAMERAS_MEDIAMTX_SECRET=
CAMERAS_PUBLIC_VIEW_URL=
CAMERAS_STREAM_BASE_URL=wss://proxy.leopardo-rh.com/cam
CAMERAS_STREAM_TOKEN_ISSUER=leopardo-rh
CAMERAS_STREAM_TOKEN_SECRET=
CAMERAS_STREAM_TOKEN_TTL=240
CAMERAS_TEST_RTSP_ENABLED=true
CAMERAS_TEST_RTSP_TIMEOUT=5

# --- config/edge.php ---
CLOUD_API_URL=https://api.leopardo.app
CLOUD_SYNC_INTERVAL_MINUTES=15
EDGE_LICENSE_PRIVATE_KEY=
EDGE_LICENSE_PUBLIC_KEY=
EDGE_LICENSE_VALIDITY_DAYS=30
EDGE_NODE_ID=
EDGE_SYNC_BATCH_SIZE=100
EDGE_TOKEN=
FORCE_OFFLINE=false
LICENSE_PUBLIC_KEY_PATH=

# --- config/communication.php ---
COMMUNICATION_EMAIL_MAX_ATTEMPTS=3
COMMUNICATION_EMAIL_PROVIDER=mail
COMMUNICATION_EMAIL_RETRY_BASE_DELAY_MS=500
COMMUNICATION_PUSH_PROVIDER=firebase
COMMUNICATION_QUEUE=notifications
COMMUNICATION_SMS_MAX_ATTEMPTS=3
COMMUNICATION_SMS_MONTHLY_QUOTA=0
COMMUNICATION_SMS_PROVIDER=audit
COMMUNICATION_SMS_RETRY_BASE_DELAY_MS=500
COMMUNICATION_WHATSAPP_MAX_ATTEMPTS=3
COMMUNICATION_WHATSAPP_MONTHLY_QUOTA=0
COMMUNICATION_WHATSAPP_PROVIDER=audit
COMMUNICATION_WHATSAPP_RETRY_BASE_DELAY_MS=500

# --- config/database.php ---
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENCRYPT=yes
DB_FOREIGN_KEYS=true
DB_SOCKET=
DB_TRUST_SERVER_CERTIFICATE=false
DB_URL=
MYSQL_ATTR_SSL_CA=
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_DB=0
REDIS_PREFIX=Str::slug(env('APP_NAME', 'laravel
REDIS_SCHEME=tls

# --- config/performance.php ---
HR_REPORT_HEADCOUNT_CACHE_TTL=60
PAYROLL_QUEUE_PDF_WARMUP=true

# --- config/logging.php ---
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_TRACE=false
LOG_DISCORD_LEVEL=error
LOG_DISCORD_USERNAME=Leopardo Alerts
LOG_DISCORD_WEBHOOK_URL=
LOG_PAPERTRAIL_HANDLER=SyslogUdpHandler::class
LOG_SENTRY_LEVEL=error
LOG_SLACK_EMOJI=:boom:
LOG_SLACK_USERNAME=Laravel Log
LOG_SLACK_WEBHOOK_URL=
LOG_STACK=single
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=LOG_USER
PAPERTRAIL_PORT=
PAPERTRAIL_URL=

# --- config/mail.php ---
MAIL_EHLO_DOMAIN=parse_url(env('APP_URL', 'http://localhost
MAIL_LOG_CHANNEL=
MAIL_SCHEME=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
MAIL_URL=
POSTMARK_MESSAGE_STREAM_ID=

# --- config/services.php ---
MARKETING_LEAD_WEBHOOK_TOKEN=
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_MONITORING_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=

# --- config/security.php ---
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CLIENT_ANALYTICS_PER_MINUTE=120
RATE_LIMIT_KIOSK_PUNCH_PER_MINUTE=30
RATE_LIMIT_PAYROLL_PER_MINUTE=60
RATE_LIMIT_PLAN_BUSINESS_PER_MINUTE=1000
RATE_LIMIT_PLAN_DEFAULT_PER_MINUTE=100
RATE_LIMIT_PLAN_ENTERPRISE_PER_MINUTE=0
RATE_LIMIT_PLAN_PROFESSIONAL_PER_MINUTE=1000
RATE_LIMIT_PLAN_PRO_PER_MINUTE=1000
RATE_LIMIT_PLAN_STARTER_PER_MINUTE=100
RATE_LIMIT_PLAN_TRIAL_PER_MINUTE=60
RATE_LIMIT_PLATFORM_PER_MINUTE=60
RATE_LIMIT_PRIVACY_PER_MINUTE=20
RATE_LIMIT_PUBLIC_CAREERS_PER_MINUTE=60
RATE_LIMIT_WEBHOOKS_INBOUND_PER_MINUTE=60
RATE_LIMIT_WEB_LOGIN_PER_MINUTE=10

# --- config/sanctum.php ---
SANCTUM_TOKEN_PREFIX=

# --- config/sentry.php ---
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=0.0.0

# --- config/session.php ---
SESSION_CONNECTION=
SESSION_COOKIE=Str::slug(env('APP_NAME', 'laravel
SESSION_DOMAIN=
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_STORE=
SESSION_TABLE=sessions

# --- config/telescope.php ---
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DOMAIN=
TELESCOPE_DRIVER=database
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_PATH=telescope
TELESCOPE_PRUNE_HOURS=48
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# --- config/tracking.php ---
TRACCAR_API_TOKEN=
TRACCAR_SYNC_INTERVAL=5
TRACCAR_URL=http://localhost:8082
TRACKING_ENABLED=false
TRACKING_SPEED_LIMIT=120
SENTRY_DSN=
# (SENTRY_DSN est un fallback interne de SENTRY_LARAVEL_DSN — env() imbriqué dans config/sentry.php)
