APP_NAME="Leopardo RH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.leopardo-rh.com
FRONTEND_URL=https://app.leopardo-rh.com
APP_TIMEZONE=UTC
# Version semver exposee par /api/v1/health (doit suivre CHANGELOG.md).
# Peut etre injectee au deploy depuis un CI var (ex : commit court).
APP_VERSION=4.16.17

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leopardo_db
DB_USERNAME=leopardo_user
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE_EN_PROD
DB_SEARCH_PATH=shared_tenants,public

# Redis — Upstash (TLS requis)
REDIS_CLIENT=predis
REDIS_URL=rediss://default:gQAAAAAAAWm1AAIgcDE1NmY0YWQ3ODc2OTQ0YWY0YjYyMjlhZDJhMTNmM2VjYw@noted-tomcat-92597.upstash.io:6379
REDIS_HOST=noted-tomcat-92597.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=gQAAAAAAAWm1AAIgcDE1NmY0YWQ3ODc2OTQ0YWY0YjYyMjlhZDJhMTNmM2VjYw
REDIS_USERNAME=default

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=VOTRE_USERNAME_SMTP
MAIL_PASSWORD=VOTRE_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@leopardo-rh.com
MAIL_FROM_NAME="Leopardo RH"

SANCTUM_STATEFUL_DOMAINS=app.leopardo-rh.com,localhost
SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://app.leopardo-rh.com,https://leopardo-rh.com

DOMPDF_PAPER_SIZE=A4
DOMPDF_ENABLE_REMOTE=false

FILESYSTEM_DISK=local

BACKUP_PATH=/var/backups/leopardo
BACKUP_KEEP_LAST=10

TELESCOPE_ENABLED=false
RATE_LIMIT_API=60
TENANCY_DEFAULT_TYPE=shared

# Super Admin (cree par SuperAdminSeeder a la 1ere execution de `php artisan leopardo:migrate --seed`)
# - Se connecte sur /platform/login (web) ou POST /api/v1/platform/auth/login (API)
# - Si SUPER_ADMIN_PASSWORD est vide, le seeder genere un mot de passe aleatoire affiche dans les logs
# - Pour changer le mot de passe a tout moment :
#     php artisan super-admin:reset-password admin@leopardo-rh.com NouveauMotDePasse
SUPER_ADMIN_EMAIL=admin@leopardo-rh.com
SUPER_ADMIN_PASSWORD=
FORCE_SUPER_ADMIN_PASSWORD_RESET=false

# Stripe — Payment provider for subscriptions
# Get your keys at https://dashboard.stripe.com/apikeys
# Create Price IDs in the Stripe Dashboard for each plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# =============================================================================
# Edge Node — Offline / Local deployment
# =============================================================================
# Activer le mode Edge (true = ce serveur est un nœud Edge local)
EDGE_ENABLED=false

# Identifiant unique de ce nœud Edge (généré par Cloud lors du provisioning)
EDGE_NODE_ID=

# Token d'authentification JWT signé par le Cloud pour ce nœud
EDGE_TOKEN=

# Clé privée RS256 (PEM) pour signer les licences Edge
# Générer : openssl genrsa -out edge_license_private.pem 2048
EDGE_LICENSE_PRIVATE_KEY=""

# Clé publique RS256 (PEM) pour vérifier les licences côté apps
# Générer : openssl rsa -in edge_license_private.pem -pubout -out edge_license_public.pem
EDGE_LICENSE_PUBLIC_KEY=""

# Durée de validité d'une licence Edge signée (en jours)
EDGE_LICENSE_TTL_DAYS=30

# URL du Cloud API parent (pour sync, renouvellement licence, heartbeat)
# Exemple : https://api.leopardo-rh.com
CLOUD_API_URL=

# Délai max sans contact Cloud avant que le nœud passe en mode dégradé (minutes)
EDGE_SILENCE_THRESHOLD_MINUTES=30

# =============================================================================
# Edge Node — URL mDNS locale (exposée par le nœud Edge sur le réseau LAN)
# =============================================================================
EDGE_LOCAL_URL=http://leopardo.local
