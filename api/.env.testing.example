# Fichier d'exemple pour l'environnement de test — AUCUNE valeur sensible.
# Copier vers .env.testing et remplir localement (jamais versionner).
# La CI génère son propre environnement (voir .github/actions/setup-backend-db).
APP_NAME=LeopardoRH
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leopardo_test
DB_USERNAME=leopardo_user
DB_PASSWORD=
DB_SEARCH_PATH=shared_tenants,public

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
