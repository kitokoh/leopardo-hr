# #9464 — SOURCE UNIQUE des constantes de calibration du déploiement.
#
# Ce fichier existe parce que la même durée a été recopiée à trois endroits
# (garde, action du gate, workflow de rattrapage) et que les trois copies ont
# divergé de la réalité. Toute valeur ci-dessous est MESURÉE, pas estimée :
# la source de la mesure est indiquée en commentaire, et la garde
# `dev-hub/tools/check-deploy-gate-budget.sh` refuse une régression.
#
# Format : KEY=VALUE, une par ligne, sans export ni guillemets.

# Durée MÉDIANE observée de `Tests - Leopardo` sur `main`.
#
# Mesure du 2026-11-14 (API GitHub, 15 derniers runs de main) :
#   533, 275, 47, 260, 239, 222, 150, 255, 244, 182, 166 min
#   → médiane 240 min, maximum 533 min.
#
# L'ancienne valeur (82 min) venait d'une estimation de 2026-11-10 qui ne
# correspondait à aucun run réel : c'est elle qui a fait porter le budget du
# gate à 100 min, insuffisant par construction.
DEPLOY_GATE_NOMINAL_MAX_MINUTES=240

# Budget d'attente du gate de déploiement (action verify-deploy-workflows).
# Doit être STRICTEMENT supérieur à la durée médiane mesurée, et STRICTEMENT
# inférieur au timeout du job `prepare` qui le porte.
DEPLOY_GATE_BUDGET_MINUTES=300

# `timeout-minutes` du job `prepare` de deploy-main.yml, qui PORTE le gate.
# Un budget supérieur à ce plafond serait inapplicable : le job serait tué
# avant d'atteindre sa propre échéance.
DEPLOY_GATE_PREPARE_TIMEOUT_MINUTES=360

# Fenêtre de polling du rattrapage horaire (`deploy-main-catchup`), en minutes.
# Le rattrapage ne peut pas attendre 240 min (il tourne toutes les heures) :
# il sert à reprendre un run MANQUÉ, pas à remplacer le gate. Il doit donc
# couvrir au moins la durée d'un run de tests court, et surtout ne plus
# conclure « annulé » en 6 min comme avant.
DEPLOY_CATCHUP_POLL_MINUTES=30
