  "journeys": [
    {
      "id": "GJ-01",
      "name": "Onboarding employé complet",
      "solution": "hr_core",
      "acceptance": "Le nouvel employé peut pointer, voir ses soldes et consulter sa fiche après création par le manager.",
      "steps": [
        {
          "order": 1,
          "action": "Créer l'entreprise (tenant)",
          "method": "POST",
          "route": "/api/v1/user/company-requests",
          "role": "public"
        },
        {
          "order": 2,
          "action": "Créer l'employé",
          "method": "POST",
          "route": "/api/v1/employees",
          "role": "manager:rh"
        },
        {
          "order": 3,
          "action": "Consulter sa fiche",
          "method": "GET",
          "route": "/api/v1/employees/{employee}",
          "role": "manager:rh"
        },
        {
          "order": 4,
          "action": "Pointer (check-in)",
          "method": "POST",
          "route": "/api/v1/attendance/check-in",
          "role": "employee"
        },
        {
          "order": 5,
          "action": "Consulter ses soldes de congés",
          "method": "GET",
          "route": "/api/v1/me/leave-balances",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-02",
      "name": "Cycle de congé complet",
      "solution": "hr_core",
      "acceptance": "Demande → approbation → solde mis à jour, sans fuite cross-tenant.",
      "steps": [
        {
          "order": 1,
          "action": "Demander un congé",
          "method": "POST",
          "route": "/api/v1/absences",
          "role": "employee"
        },
        {
          "order": 2,
          "action": "Lister les demandes",
          "method": "GET",
          "route": "/api/v1/absences",
          "role": "manager:rh"
        },
        {
          "order": 3,
          "action": "Approuver",
          "method": "POST",
          "route": "/api/v1/absences/{absence}/approve",
          "role": "manager:rh"
        },
        {
          "order": 4,
          "action": "Vérifier le solde",
          "method": "GET",
          "route": "/api/v1/me/leave-balances",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-03",
      "name": "Cycle de paie",
      "solution": "hr_core",
      "acceptance": "Run → calcul → validation → bulletin consultable par l'employé, idempotent.",
      "steps": [
        {
          "order": 1,
          "action": "Créer un run de paie",
          "method": "POST",
          "route": "/api/v1/payroll-runs",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Calculer",
          "method": "POST",
          "route": "/api/v1/payroll-runs/{payrollRun}/calculate",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Valider",
          "method": "POST",
          "route": "/api/v1/payroll-runs/{payrollRun}/validate",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Consulter son bulletin",
          "method": "GET",
          "route": "/api/v1/me/pay-slips",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-04",
      "name": "Clôture comptable",
      "solution": "hr_core",
      "acceptance": "Écritures → clôture d'exercice → export FEC cohérent.",
      "steps": [
        {
          "order": 1,
          "action": "Consulter le journal",
          "method": "GET",
          "route": "/api/v1/accounting/journal",
          "role": "manager:comptable"
        },
        {
          "order": 2,
          "action": "Clôturer un exercice",
          "method": "POST",
          "route": "/api/v1/accounting/fiscal-years/{year}/close",
          "role": "manager:comptable"
        },
        {
          "order": 3,
          "action": "Exporter FEC",
          "method": "GET",
          "route": "/api/v1/accounting/journal/export-fec",
          "role": "manager:comptable"
        }
      ]
    },
    {
      "id": "GJ-05",
      "name": "Pipeline CRM client",
      "solution": "crm_client",
      "acceptance": "Import des comptes/contacts → commit → conversion de lead, tenant-scoped, feature flag crm.",
      "steps": [
        {
          "order": 1,
          "action": "Importer les comptes/contacts",
          "method": "POST",
          "route": "/api/v1/crm/imports",
          "role": "manager"
        },
        {
          "order": 2,
          "action": "Suivre l'import",
          "method": "GET",
          "route": "/api/v1/crm/imports/{crmImport}",
          "role": "manager"
        },
        {
          "order": 3,
          "action": "Committer l'import (crée comptes/contacts)",
          "method": "POST",
          "route": "/api/v1/crm/imports/{crmImport}/commit",
          "role": "manager"
        },
        {
          "order": 4,
          "action": "Convertir un lead",
          "method": "POST",
          "route": "/api/v1/crm/leads/{crmLead}/convert",
          "role": "manager"
        }
      ]
    },
    {
      "id": "GJ-06",
      "name": "Pilote FuelStation — station → vente",
      "solution": "fuelstation",
      "acceptance": "Manifest activé → station → pompe → relevé compteur → vente par pompe → écart expliqué.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution",
          "method": "POST",
          "route": "/api/v1/solutions/fuelstation/activate",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Créer une station",
          "method": "POST",
          "route": "/api/v1/fuel/stations",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Créer une pompe",
          "method": "POST",
          "route": "/api/v1/fuel/pumps",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Relevé de compteur",
          "method": "POST",
          "route": "/api/v1/fuel/meter-readings",
          "role": "operator"
        },
        {
          "order": 5,
          "action": "Vente par pompe",
          "method": "POST",
          "route": "/api/v1/fuel/sales",
          "role": "operator"
        }
      ]
    },
    {
      "id": "GJ-07",
      "name": "Pilote EduManager — campus → présence",
      "solution": "edumanager",
      "acceptance": "Manifest activé → campus → classe → élève → présence scolaire enregistrée.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution",
          "method": "POST",
          "route": "/api/v1/solutions/edumanager/activate",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Créer un campus",
          "method": "POST",
          "route": "/api/v1/edu/campuses",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Créer une classe",
          "method": "POST",
          "route": "/api/v1/edu/classes",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Inscrire un élève",
          "method": "POST",
          "route": "/api/v1/edu/students",
          "role": "manager:principal"
        },
        {
          "order": 5,
          "action": "Enregistrer une présence",
          "method": "POST",
          "route": "/api/v1/edu/attendance",
          "role": "teacher"
        }
      ]
    },
    {
      "id": "GJ-08",
      "name": "Assistant IA : chat → action confirmée → audit",
      "solution": "bc23_ai",
      "acceptance": "Une demande faite à l'assistant IA crée une action en attente de confirmation humaine ; la confirmation applique l'effet métier (jamais sans confirmation) et l'échange complet est tracé dans ai_audit_logs (traçabilité).",
      "steps": [
        {
          "order": 1,
          "action": "Envoyer un message à l'assistant IA",
          "method": "POST",
          "route": "/api/v1/ai/chat",
          "role": "employee"
        },
        {
          "order": 2,
          "action": "Confirmer l'action d'écriture proposée",
          "method": "POST",
          "route": "/api/v1/ai/actions/{pendingActionId}/confirm",
          "role": "employee"
        },
        {
          "order": 3,
          "action": "Consulter l'historique des conversations",
          "method": "GET",
          "route": "/api/v1/ai/chat/history",
          "role": "employee"
        },
        {
          "order": 4,
          "action": "Vérifier l'usage (tokens, p95, coûts)",
          "method": "GET",
          "route": "/api/v1/ai/analytics/usage",
          "role": "manager:rh"
        }
      ]
    },
    {
      "id": "GJ-DELIVERY-01",
      "name": "Livraison dernier-kilomètre — parcours agence complet",
      "solution": "delivery",
      "acceptance": "3 colis (dont 1 COD) → tournée affectée livreur+véhicule → events mobile picked_up→delivered (POD) / failed→returned → clôture (totaux) → rapport manager (taux de succès, COD) → lien destinataire. Deux clôtures → mêmes totaux.",
      "steps": [
        {
          "order": 1,
          "action": "Créer les colis (dont 1 COD)",
          "method": "POST",
          "route": "/api/v1/delivery/deliveries",
          "role": "delivery.dispatcher"
        },
        {
          "order": 2,
          "action": "Créer la tournée du jour",
          "method": "POST",
          "route": "/api/v1/delivery/deliveries/routes",
          "role": "delivery.dispatcher"
        },
        {
          "order": 3,
          "action": "Affecter livreur + véhicule",
          "method": "POST",
          "route": "/api/v1/delivery/deliveries/routes/{route}/assign",
          "role": "delivery.dispatcher"
        },
        {
          "order": 4,
          "action": "Événements mobile (picked_up→delivered avec POD, failed→returned)",
          "method": "POST",
          "route": "/api/v1/delivery/deliveries/events",
          "role": "delivery.rider"
        },
        {
          "order": 5,
          "action": "Clôturer la tournée (totaux, idempotente)",
          "method": "POST",
          "route": "/api/v1/delivery/deliveries/routes/{route}/close",
          "role": "delivery.dispatcher"
        },
        {
          "order": 6,
          "action": "Rapport manager (taux de succès, COD)",
          "method": "GET",
          "route": "/api/v1/delivery/deliveries/reports/summary",
          "role": "delivery.manager"
        },
        {
          "order": 7,
          "action": "Suivi destinataire par lien borné",
          "method": "GET",
          "route": "/api/v1/deliveries/tracking/{token}",
          "role": "public"
        }
      ]
    },
    {
      "id": "GJ-RESTO-01",
      "name": "Restaurant — caisse → commande → paiement → clôture",
      "solution": "restaurantmanager",
      "acceptance": "Session de caisse ouverte → commande sur table → ajout d'articles → addition → paiement (cash) → clôture de session : totaux cohérents, caisse immuable, idempotent. Deux clôtures → mêmes totaux.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution",
          "method": "POST",
          "route": "/api/v1/solutions/restaurantmanager/activate",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Ouvrir une session de caisse",
          "method": "POST",
          "route": "/api/v1/restaurant/pos-sessions",
          "role": "restaurant.cashier"
        },
        {
          "order": 3,
          "action": "Créer une commande (table)",
          "method": "POST",
          "route": "/api/v1/restaurant/orders",
          "role": "restaurant.cashier"
        },
        {
          "order": 4,
          "action": "Ajouter des articles",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{order}/items",
          "role": "restaurant.cashier"
        },
        {
          "order": 5,
          "action": "Éditer l'addition",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{order}/bill",
          "role": "restaurant.cashier"
        },
        {
          "order": 6,
          "action": "Encaisser (paiement cash)",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{order}/payments",
          "role": "restaurant.cashier"
        },
        {
          "order": 7,
          "action": "Clôturer la session de caisse (idempotente)",
          "method": "POST",
          "route": "/api/v1/restaurant/pos-sessions/{session}/close",
          "role": "restaurant.manager"
        }
      ]
    },
    {
      "id": "GJ-TRAVEL-01",
      "name": "TravelAgency — recherche → réservation → paiement → billet → check-in",
      "solution": "travelagency",
      "acceptance": "Un agent peut rechercher un trajet, réserver au guichet, encaisser, émettre les billets et enregistrer l'embarquement.",
      "steps": [
        {
          "order": 1,
          "action": "Rechercher un trajet",
          "method": "GET",
          "route": "/api/v1/travel/trips/search",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Réserver au guichet (multi-passagers)",
          "method": "POST",
          "route": "/api/v1/travel/bookings",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Confirmer (paiement comptant)",
          "method": "POST",
          "route": "/api/v1/travel/bookings/{travelBooking}/confirm",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Émettre les billets",
          "method": "POST",
          "route": "/api/v1/travel/bookings/{travelBooking}/issue-ticket",
          "role": "manager:principal"
        },
        {
          "order": 5,
          "action": "Check-in passager",
          "method": "POST",
          "route": "/api/v1/travel/tickets/{travelTicket}/check-in",
          "role": "manager:principal"
        }
      ]
    }
  ]
}
