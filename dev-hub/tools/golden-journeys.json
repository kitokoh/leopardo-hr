{
  "solutions": {
    "hr_core": {
      "label": "HR Core (plateforme RH)",
      "status": "active"
    },
    "crm_client": {
      "label": "CRM client (tenant)",
      "status": "active"
    },
    "fuelstation": {
      "label": "FuelStation (verticale)",
      "status": "planned"
    },
    "edumanager": {
      "label": "EduManager (verticale)",
      "status": "planned"
    },
    "restaurantmanager": {
      "label": "RestaurantManager (verticale)",
      "status": "planned"
    }
  },
  "journeys": [
    {
      "id": "GJ-01",
      "name": "Onboarding employé complet",
      "solution": "hr_core",
      "acceptance": "Le nouvel employé peut pointer, voir ses soldes et consulter sa fiche après création par le manager.",
      "steps": [
        {
          "order": 1,
          "action": "Créer l'entreprise (tenant)",
          "method": "POST",
          "route": "/api/v1/user/company-requests",
          "role": "public"
        },
        {
          "order": 2,
          "action": "Créer l'employé",
          "method": "POST",
          "route": "/api/v1/employees",
          "role": "manager:rh"
        },
        {
          "order": 3,
          "action": "Consulter sa fiche",
          "method": "GET",
          "route": "/api/v1/employees/{employee}",
          "role": "manager:rh"
        },
        {
          "order": 4,
          "action": "Pointer (check-in)",
          "method": "POST",
          "route": "/api/v1/attendance/check-in",
          "role": "employee"
        },
        {
          "order": 5,
          "action": "Consulter ses soldes de congés",
          "method": "GET",
          "route": "/api/v1/me/leave-balances",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-02",
      "name": "Cycle de congé complet",
      "solution": "hr_core",
      "acceptance": "Demande → approbation → solde mis à jour, sans fuite cross-tenant.",
      "steps": [
        {
          "order": 1,
          "action": "Demander un congé",
          "method": "POST",
          "route": "/api/v1/absences",
          "role": "employee"
        },
        {
          "order": 2,
          "action": "Lister les demandes",
          "method": "GET",
          "route": "/api/v1/absences",
          "role": "manager:rh"
        },
        {
          "order": 3,
          "action": "Approuver",
          "method": "POST",
          "route": "/api/v1/absences/{absence}/approve",
          "role": "manager:rh"
        },
        {
          "order": 4,
          "action": "Vérifier le solde",
          "method": "GET",
          "route": "/api/v1/me/leave-balances",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-03",
      "name": "Cycle de paie",
      "solution": "hr_core",
      "acceptance": "Run → calcul → validation → bulletin consultable par l'employé, idempotent.",
      "steps": [
        {
          "order": 1,
          "action": "Créer un run de paie",
          "method": "POST",
          "route": "/api/v1/payroll-runs",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Calculer",
          "method": "POST",
          "route": "/api/v1/payroll-runs/{payrollRun}/calculate",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Valider",
          "method": "POST",
          "route": "/api/v1/payroll-runs/{payrollRun}/validate",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Consulter son bulletin",
          "method": "GET",
          "route": "/api/v1/me/pay-slips",
          "role": "employee"
        }
      ]
    },
    {
      "id": "GJ-04",
      "name": "Clôture comptable",
      "solution": "hr_core",
      "acceptance": "Écritures → clôture d'exercice → export FEC cohérent.",
      "steps": [
        {
          "order": 1,
          "action": "Consulter le journal",
          "method": "GET",
          "route": "/api/v1/accounting/journal",
          "role": "manager:comptable"
        },
        {
          "order": 2,
          "action": "Clôturer un exercice",
          "method": "POST",
          "route": "/api/v1/accounting/fiscal-years/{year}/close",
          "role": "manager:comptable"
        },
        {
          "order": 3,
          "action": "Exporter FEC",
          "method": "GET",
          "route": "/api/v1/accounting/journal/export-fec",
          "role": "manager:comptable"
        }
      ]
    },
    {
      "id": "GJ-05",
      "name": "Pipeline CRM client",
      "solution": "crm_client",
      "acceptance": "Import des comptes/contacts → commit → conversion de lead, tenant-scoped, feature flag crm.",
      "steps": [
        {
          "order": 1,
          "action": "Importer les comptes/contacts",
          "method": "POST",
          "route": "/api/v1/crm/imports",
          "role": "manager"
        },
        {
          "order": 2,
          "action": "Suivre l'import",
          "method": "GET",
          "route": "/api/v1/crm/imports/{crmImport}",
          "role": "manager"
        },
        {
          "order": 3,
          "action": "Committer l'import (crée comptes/contacts)",
          "method": "POST",
          "route": "/api/v1/crm/imports/{crmImport}/commit",
          "role": "manager"
        },
        {
          "order": 4,
          "action": "Convertir un lead",
          "method": "POST",
          "route": "/api/v1/crm/leads/{crmLead}/convert",
          "role": "manager"
        }
      ]
    },
    {
      "id": "GJ-06",
      "name": "Pilote FuelStation — station → vente",
      "solution": "fuelstation",
      "acceptance": "Manifest activé → station → pompe → relevé compteur → vente par pompe → écart expliqué.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution",
          "method": "POST",
          "route": "/api/v1/solutions/fuelstation/activate",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Créer une station",
          "method": "POST",
          "route": "/api/v1/fuel/stations",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Créer une pompe",
          "method": "POST",
          "route": "/api/v1/fuel/pumps",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Relevé de compteur",
          "method": "POST",
          "route": "/api/v1/fuel/meter-readings",
          "role": "operator"
        },
        {
          "order": 5,
          "action": "Vente par pompe",
          "method": "POST",
          "route": "/api/v1/fuel/sales",
          "role": "operator"
        }
      ]
    },
    {
      "id": "GJ-07",
      "name": "Pilote EduManager — campus → présence",
      "solution": "edumanager",
      "acceptance": "Manifest activé → campus → classe → élève → présence scolaire enregistrée.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution",
          "method": "POST",
          "route": "/api/v1/solutions/edumanager/activate",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Créer un campus",
          "method": "POST",
          "route": "/api/v1/edu/campuses",
          "role": "manager:principal"
        },
        {
          "order": 3,
          "action": "Créer une classe",
          "method": "POST",
          "route": "/api/v1/edu/classes",
          "role": "manager:principal"
        },
        {
          "order": 4,
          "action": "Inscrire un élève",
          "method": "POST",
          "route": "/api/v1/edu/students",
          "role": "manager:principal"
        },
        {
          "order": 5,
          "action": "Enregistrer une présence",
          "method": "POST",
          "route": "/api/v1/edu/attendance",
          "role": "teacher"
        }
      ]
    },
    {
      "id": "GJ-RESTO-01",
      "name": "Pilote RestaurantManager — caisse → commande → paiement → clôture",
      "solution": "restaurantmanager",
      "acceptance": "Session de caisse ouverte → commande salle créée avec articles → servie → encaissée (cash) → caisse clôturée avec écart nul ; événements outbox publiés.",
      "steps": [
        {
          "order": 1,
          "action": "Activer la solution (flag)",
          "method": "POST",
          "route": "/api/v1/restaurant/ping",
          "role": "manager:principal"
        },
        {
          "order": 2,
          "action": "Ouvrir une session de caisse",
          "method": "POST",
          "route": "/api/v1/restaurant/pos-sessions",
          "role": "manager:server"
        },
        {
          "order": 3,
          "action": "Créer une commande (salle)",
          "method": "POST",
          "route": "/api/v1/restaurant/orders",
          "role": "manager:server"
        },
        {
          "order": 4,
          "action": "Ajouter un article",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{restaurantOrder}/items",
          "role": "manager:server"
        },
        {
          "order": 5,
          "action": "Soumettre et confirmer la commande",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{restaurantOrder}/submit",
          "role": "manager:server"
        },
        {
          "order": 6,
          "action": "Servir la commande",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{restaurantOrder}/serve",
          "role": "manager:server"
        },
        {
          "order": 7,
          "action": "Encaisser (cash)",
          "method": "POST",
          "route": "/api/v1/restaurant/orders/{restaurantOrder}/pay",
          "role": "manager:server"
        },
        {
          "order": 8,
          "action": "Clôturer la caisse",
          "method": "POST",
          "route": "/api/v1/restaurant/pos-sessions/{restaurantPosSession}/close",
          "role": "manager:server"
        }
      ]
    }
  ]
}